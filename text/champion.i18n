    "description": {
      "avatar_wan": {
        "name": "Avatar Wan",
        "attack": "Wan's basic attacks deal <#ff9028ff>50% <i#asset/base/ui/banpick/champion_stat_icon:ad_0> AD physical damage<> and <#ff9028ff>50% <i#asset/base/ui/banpick/champion_stat_icon:ad_0> AD<> <#a974ffff>magic damage<> and apply a different on-hit effect based on his current element.",
        "skill": "Wan swaps to the next element in-sequence.\n<#ff4d2cff>Fire<>: Burn for <#a974ffff>12 <#a974ffff>(+30% <i#asset/base/ui/banpick/champion_stat_icon:ap_0> AP)<> magic damage<> over <#e8a800ff>3 seconds<>.\n<#ffe599ff>Air<>: Gain <#ffffffff>6% <i#asset/base/ui/banpick/champion_stat_icon:speed_0> movement speed<> for <#e8a800ff>4 seconds<> (max 4 stacks).\n<#3c78d8ff>Water<>: Heal for <#60e84dff>3<> + <#60e84dff>3%<> of your <#60e84dff>missing health<>.\n<#38871dff>Earth<>: Basic attacks deal <#e8a800ff>40%<> of their damage to nearby enemies.",
        "skill2": "Wan <#ceff99ff>dashes<> a short distance in any direction. For the next <#e8a800ff>3 seconds<>, he stores <#d94c49ff>80% of his damage taken<> and gains <#ceff99ff>10% <#ff9028ff>(+0.03% <i#asset/base/ui/banpick/champion_stat_icon:ad_0> AD)<> bonus <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0> attack speed<>. When <#e8a800ff>Spirit Step<> expires, Wan <#60e84dff>heals himself<> for <#60e84dff>30<> + <#60e84dff>80%<> of the stored damage.",
        "ult": "Wan channels Raava's full power, gaining a <#cab944ff>300 <#a974ffff>(+60% <i#asset/base/ui/banpick/champion_stat_icon:ap_0> AP)<> <#60e84dff>(+6% <i#asset/base/ui/banpick/champion_stat_icon:hp_0> HP)<> health shield<> for <#e8a800ff>6 seconds<>. For the duration, Wan's basic attacks apply the effects of <#e8a800ff>all 4 elements<>. Harmonic Convergence's duration is extended by <#e8a800ff>1.5 seconds<> whenever Wan gets a <#e8a800ff>takedown<>."
      },
      "ty_lee": {
        "attack": "Ty Lee's basic attacks deal <#ff9028ff>100% <i#asset/base/ui/banpick/champion_stat_icon:ad_0> AD physical damage<> and apply a stack of <#e8a800ff>Chi Block<> to enemy champions, up to <#e8a800ff>4<> times. The fourth stack consumes them all to deal <#a974ffff>85 bonus magic damage<> and <#d94c49ff>stun<> the target for <#e8a800ff>1 second<>.",
        "name": "Ty Lee",
        "skill": "Ty Lee strikes the target <#e8a800ff>3 times<> in quick succession, each dealing <#ff9028ff>40 (+40% <i#asset/base/ui/banpick/champion_stat_icon:ad_0> AD) physical damage<> and applying <#e8a800ff>Chi Block<>. Each hit can <#d45656ff><i#asset/base/ui/banpick/champion_stat_icon:crit_chance_0> critically strike<> for <#e8a800ff>20% bonus damage<>.",
        "skill2": "Ty Lee <#ceff99ff>dashes<> a short distance in any direction, <#cab944ff>shielding herself<> for <#cab944ff>100 <#ff9028ff>(+20% <i#asset/base/ui/banpick/champion_stat_icon:ad_0> AD)<> <#60e84dff>(+10% <i#asset/base/ui/banpick/champion_stat_icon:hp_0> HP)<> health<> for <#e8a800ff>4 seconds<>. While the shield holds, she <#ceff99ff>dodges<> all basic attacks.",
        "ult": "Ty Lee <#ceff99ff>dashes<> to the <#60e84dff>highest health<> enemy champion within <#ff86c2ff>120 <i#asset/base/ui/banpick/champion_stat_icon:range_0> range<>, dealing <#ff9028ff>220 (+80% <i#asset/base/ui/banpick/champion_stat_icon:ad_0> AD) <#d45656ff>(+100% <i#asset/base/ui/banpick/champion_stat_icon:crit_chance_0>)<> physical damage<> in a small area and <#d94c49ff>silencing<> all champions hit for <#e8a800ff>1.5 seconds<>. Her next basic attack always <i#asset/base/ui/banpick/champion_stat_icon:crit_chance_0> <#d45656ff>critically strikes<> and stacks <#e8a800ff>Chi Block<> twice."
      }
    }
  }
}